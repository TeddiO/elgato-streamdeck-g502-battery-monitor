{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"customConditions": [
			"node"
		],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"rootDir": "src",
		"outDir": ".build",
		"noEmitOnError": true,
		"importHelpers": true,
		"sourceMap": true,
		"inlineSources": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}